BMS_DATABASE_URL=postgresql://bms_login:REPLACE_ME@localhost:5432/bms
BMS_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BMS_INTERACTIVE_HOURS=8
BMS_SYNC_HOURS=72
BMS_OFFLINE_GRANT_HOURS=72
BMS_PASSWORD_MIN_LENGTH=15
BMS_FAILED_PASSWORD_LIMIT=5
BMS_LOCKOUT_MINUTES=15
BMS_SCHEDULER_INTERVAL_MINUTES=15
BMS_SCHEDULING_HORIZON_DAYS=7
BMS_EVIDENCE_DIRECTORY=.local\evidence
BMS_EVIDENCE_MAX_BYTES=500000
BMS_EVIDENCE_MAX_DIMENSION=1600
BMS_CLOCK_WARNING_SECONDS=300
BMS_EVIDENCE_TICKET_SECONDS=300
# Optional sensor service: use a school-scoped reader credential, not a device token.
# BMS_SENSOR_SERVICE_URL=http://127.0.0.1:8010
# BMS_SENSOR_SERVICE_TOKEN=GENERATE_AND_KEEP_PRIVATE
BMS_SENSOR_POLL_SECONDS=15
